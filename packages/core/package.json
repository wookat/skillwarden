{
  "name": "skillwarden-core",
  "version": "0.7.0",
  "description": "SkillWarden core engine: Agent Skills (SKILL.md) security scanning rules, lockfile spec, skill directory discovery",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wookat/skillwarden.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/wookat/skillwarden",
  "bugs": "https://github.com/wookat/skillwarden/issues",
  "keywords": [
    "agent-skills",
    "skill-md",
    "security",
    "supply-chain",
    "lockfile",
    "scanner",
    "prompt-injection"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "@vitest/coverage-v8": "4.1.10"
  }
}
