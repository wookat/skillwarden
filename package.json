{
  "name": "skillwarden-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm --filter \"!@skillwarden/site\" -r build",
    "lint": "eslint .",
    "typecheck": "pnpm --filter \"!@skillwarden/site\" -r typecheck",
    "test": "pnpm --filter \"!@skillwarden/site\" -r test",
    "site:dev": "pnpm --filter @skillwarden/site dev",
    "site:build": "pnpm --filter @skillwarden/site build",
    "changeset": "changeset",
    "release": "pnpm build && pnpm --filter \"!@skillwarden/site\" -r publish --access public --no-git-checks"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10",
    "@changesets/cli": "^3.0.0"
  }
}
